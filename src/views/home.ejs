<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Express TDD Template</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 24px;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      padding: 40px;
      width: 100%;
      max-width: 560px;
    }

    .card h1 { font-size: 24px; margin-bottom: 4px; }
    .card .subtitle { color: #6b7280; margin-bottom: 24px; font-size: 14px; }

    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px; }
    .field input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
    }
    .field input:focus { outline: 2px solid #2563eb; border-color: transparent; }

    .alert {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 14px;
      display: none;
    }

    .btn {
      display: block;
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #d1d5db;
      background: #fff;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      color: #111827;
      transition: background 0.15s ease;
      margin-bottom: 10px;
    }
    .btn:hover { background: #f9fafb; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; margin-bottom: 0; }
    .btn-primary:hover { background: #1d4ed8; }

    .divider {
      display: flex;
      align-items: center;
      color: #9ca3af;
      font-size: 13px;
      margin: 20px 0;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #e5e7eb;
    }
    .divider span { padding: 0 12px; }

    /* Bind card */
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 20px;
    }

    .tile {
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: #fafafa;
    }
    .tile.bound { background: #f0fdf4; border-color: #86efac; }

    .tile-header { display: flex; align-items: center; gap: 8px; }
    .tile-header h3 { font-size: 14px; font-weight: 600; }

    .dot { width: 10px; height: 10px; border-radius: 50%; background: #d1d5db; }
    .tile.bound .dot { background: #22c55e; }

    .identifier { font-size: 14px; color: #111827; font-weight: 500; word-break: break-all; }

    .badge {
      align-self: flex-start;
      background: #dcfce7;
      color: #15803d;
      font-size: 12px;
      padding: 3px 8px;
      border-radius: 999px;
    }

    .tile .btn { font-size: 13px; padding: 8px 10px; margin-bottom: 0; }

    .logout {
      display: inline-block;
      margin-top: 24px;
      color: #b91c1c;
      font-size: 14px;
      text-decoration: none;
    }
    .logout:hover { text-decoration: underline; }

    /* Password bind form (inline in tile) */
    .bind-form { display: none; margin-top: 8px; }
    .bind-form.open { display: block; }
    .bind-form input {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 13px;
      margin-bottom: 8px;
    }
    .bind-form .row { display: flex; gap: 8px; }
    .bind-form .row .btn { flex: 1; }
  </style>
</head>
<body>

  <% if (isLoggedIn) { %>
    <div class="card">
      <h1>Hello, <%= user.username %></h1>
      <p class="subtitle">Connect your account with the following providers to sign in with them later.</p>

      <div class="grid">
        <%
          const providers = [
            { id: 'password',  label: 'Password'  },
            { id: 'google',    label: 'Google'    },
            { id: 'github',    label: 'GitHub'    },
            { id: 'discord',   label: 'Discord'   },
            { id: 'microsoft', label: 'Microsoft' },
          ];
          const getBound = (providerId) => userAuths.find((auth) => auth.provider === providerId);
        %>

        <% for (const provider of providers) { %>
          <% const bound = getBound(provider.id); %>
          <div class="tile <%= bound ? 'bound' : '' %>">
            <div class="tile-header">
              <span class="dot"></span>
              <h3><%= provider.label %></h3>
            </div>

            <% if (bound) { %>
              <p class="identifier"><%= bound.displayIdentifier %></p>
              <span class="badge"><%= bound.provider %></span>
              <% if (provider.id !== 'password' && userAuths.length >= 2) { %>
                <button class="btn" type="button" onclick="unbindProvider('<%= provider.id %>')">Unbind</button>
              <% } %>
            <% } else { %>
              <% if (provider.id === 'password') { %>
                <button class="btn" type="button" onclick="document.getElementById('password-bind').classList.add('open')">Bind with password</button>
                <div class="bind-form" id="password-bind">
                  <input type="hidden" id="bind-user-id" value="<%= user.id %>">
                  <input type="text" id="bind-username" placeholder="New username" autocomplete="username">
                  <input type="password" id="bind-password" placeholder="New password" autocomplete="new-password">
                  <input type="password" id="bind-confirm" placeholder="Confirm password" autocomplete="new-password">
                  <div class="row">
                    <button class="btn" type="button" onclick="bindPassword()">Save</button>
                    <button class="btn" type="button" onclick="this.closest('.bind-form').classList.remove('open')">Cancel</button>
                  </div>
                </div>
              <% } else if (provider.id === 'google' || provider.id === 'github' || provider.id === 'discord' || provider.id === 'microsoft') { %>
                <a class="btn" href="/api/v1/auth/<%= provider.id %>-bind">Bind with <%= provider.label %></a>
              <% } else { %>
                <button class="btn" type="button" title="Not implemented yet" onclick="alert('<%= provider.label %> bind is not implemented yet')">Bind with <%= provider.label %></button>
              <% } %>
            <% } %>
          </div>
        <% } %>
      </div>

      <a class="logout" href="/api/v1/auth/logout">Logout</a>
    </div>

  <% } else { %>
    <div class="card">
      <h1>Login</h1>
      <p class="subtitle">Sign in to manage your connected accounts.</p>

      <div class="alert" id="login-alert"></div>

      <form id="login-form">
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" autocomplete="username">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password">
        </div>
        <button class="btn btn-primary" type="submit">Login</button>
      </form>

      <div class="divider"><span>or continue with</span></div>

      <a class="btn" href="/api/v1/auth/google">Login with Google</a>
      <a class="btn" href="/api/v1/auth/github">Login with GitHub</a>
      <a class="btn" href="/api/v1/auth/discord">Login with Discord</a>
      <a class="btn" href="/api/v1/auth/microsoft">Login with Microsoft</a>
    </div>
  <% } %>

  <% if (!isLoggedIn) { %>
    <script>
      const alertBox = document.getElementById('login-alert');

      document.getElementById('login-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        alertBox.style.display = 'none';

        const username = document.getElementById('username').value;
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/api/v1/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });
          const data = await res.json();

          if (!res.ok) {
            alertBox.textContent = data.message || 'Login failed';
            alertBox.style.display = 'block';
            return;
          }

          window.location.href = '/';
        } catch (error) {
          alertBox.textContent = 'Something went wrong. Please try again.';
          alertBox.style.display = 'block';
        }
      });
    </script>
  <% } else { %>
    <script>
      async function bindPassword() {
        const id = document.getElementById('bind-user-id').value;
        const username = document.getElementById('bind-username').value;
        const password = document.getElementById('bind-password').value;
        const confirmPassword = document.getElementById('bind-confirm').value;

        const res = await fetch('/api/v1/auth/password/bind', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, username, password, confirmPassword }),
        });
        const data = await res.json();

        if (res.ok) {
          window.location.href = '/';
        } else {
          alert(data.message || 'Binding failed');
        }
      }

      async function unbindProvider(providerId) {
        if (!confirm('Unbind this account?')) return;

        const res = await fetch(`/api/v1/auth/${providerId}/unbind`, {
          method: 'POST',
        });
        const data = await res.json();

        if (res.ok) {
          window.location.href = '/';
        } else {
          alert(data.message || 'Unbind failed');
        }
      }
    </script>
  <% } %>
</body>
</html>