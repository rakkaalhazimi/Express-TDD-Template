{
  "name": "express-js-tdd",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts -e ts,js,ejs,html",
    "build": "tsc -p tsconfig.build.json && tsc-alias tsconfig.build.json && node scripts/copy-assets.mts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "mikro-orm:debug": "mikro-orm debug",
    "mikro-orm:migration:list": "mikro-orm migration:list",
    "mikro-orm:migration:generate": "mikro-orm migration:create -n",
    "mikro-orm:migration:up": "mikro-orm migration:up",
    "mikro-orm:migration:down": "mikro-orm migration:down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.(spec|test).[jt]s"
    ]
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@libsql/client": "^0.17.4",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@mikro-orm/seeder": "^7.1.14",
    "@mikro-orm/sqlite": "^7.1.14",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-status-codes": "^2.3.0"
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./src/db/mikro-orm.config.ts",
      "./dist/db/mikro-orm.config.js"
    ]
  }
}
